# ==========================================
# AIP Enterprise Monorepo Master .gitignore
# ==========================================

# --- Python Bytecode, Caches & Builds ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv
.venv/
venv
venv/
ENV/
env/
.uv/

# --- Testing & Coverage Caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Environment Variables, Tokens & Sensitive Secrets ---
# (NEVER commit live secrets, credentials, or private keys)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.gpg
*.asc
id_rsa
id_rsa*
id_ed25519
id_ed25519*
*credentials*.json
*service-account*.json
client_secret*.json

# --- Kubernetes & Cloud Infrastructure Credentials ---
# (Prevent accidental leakage of local kubeconfigs and secret files)
*kubeconfig*
*.kubeconfig
*.secret.local.yaml
*secrets.local.yaml
*-values.local.yaml
values.local.yaml
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# --- Local Docker & Container Overrides ---
docker-compose.override.yml
docker-compose.local.yml
docker-compose.*.local.yml

# --- Database & Persistent Volume Local Storage ---
# (Prevent pushing raw database files or GBs of volume data)
*.sqlite
*.sqlite3
*.db
*.dump
mongo_data/
redis_data/
minio_data/
rabbitmq_data/
postgres_data/
data/

# --- Heavy AI Model Weights & Cache ---
# (Model weights are pulled dynamically at runtime from MinIO/HuggingFace)
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.engine
*.gguf
/models/
models_cache/
hf_cache/
!packages/common/common/models/

# --- ML Tracking & Training Runs ---
wandb/
runs/
checkpoints/
.neptune/

# --- Logs & Temporary Files ---
*.log
logs/
tmp/
scratch/
*.swp
*.swo
*~
*.bak
*.orig

# --- IDEs & OS System Files ---
.idea/
.vscode/
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- .NET 8 SDK Build Artifacts ---
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.suo

# --- Frontend Node.js & Vite Artifacts ---
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
