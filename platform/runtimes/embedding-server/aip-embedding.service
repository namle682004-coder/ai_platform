# systemd unit for the GPU host (msp / 172.16.20.2).
# Install:  sudo cp aip-embedding.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now aip-embedding
[Unit]
Description=AIP Embedding & Reranking Server (BGE-M3 + BGE-Reranker-v2-m3) on :8012
After=network-online.target

[Service]
User=lenam
WorkingDirectory=/home/lenam/aip/embedding-server
EnvironmentFile=-/home/lenam/aip/embedding-server/.env
# `python -m uvicorn` also works when uvicorn comes from a reused env (e.g. a .pth onto ~/vllm-env)
ExecStart=/home/lenam/aip/embedding-server/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8012 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
