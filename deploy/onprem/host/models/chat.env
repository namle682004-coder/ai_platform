# Chat LLM runtime (Qwen2.5-7B-Instruct Q4_K_M) – /etc/aip/models/chat.env
LLAMA_SERVER=/home/lenam/llama.cpp/build/bin/llama-server
MODEL_PATH=/home/lenam/models/Qwen2.5-7B-Instruct/Qwen2.5-7B-Instruct-Q4_K_M.gguf
HOST=0.0.0.0
PORT=8011
# -ngl 99      every layer on the GPU (TITAN Xp 12 GB): the weights live in VRAM, not in host RAM.
# --no-mmap    do not keep a memory-mapped copy of the weight file in host RAM.
# --parallel 4 4 parallel slots (upgraded for 32 GB host RAM; matches RAG_LLM_MAX_CONCURRENT=4).
# -c 16384     context shared by the slots (4096 tokens per slot if 4 concurrent, or 8192 if 2 concurrent).
LLAMA_ARGS=-ngl 99 --no-mmap --parallel 4 -c 16384 --timeout 120
MEMORY_HIGH=3G
MEMORY_MAX=5G
