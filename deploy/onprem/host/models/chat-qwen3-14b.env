# CANDIDATE chat runtime for the lab: quality first, one request at a time.
# Qwen3-14B Q4_K_M (~9.0 GB) on the TITAN Xp 12 GB, replacing Qwen2.5-7B Q4_K_M (~4.4 GB).
# To use: copy over /etc/aip/models/chat.env on msp (keep the old file to roll back), restart aip-model@chat,
# then set the RAG overrides at the bottom and run the benchmark before/after.
LLAMA_SERVER=/home/lenam/llama.cpp/build/bin/llama-server
MODEL_PATH=/home/lenam/models/Qwen3-14B/Qwen3-14B-Q4_K_M.gguf
HOST=0.0.0.0
PORT=8011
# VRAM budget (12 GB):
#   weights                         ~9.0 GB
#   KV cache, 12k tokens, q8_0      ~1.0 GB  (40 layers x 8 KV heads x 128 dims; f16 would be ~2 GB)
#   embedding + rerank runtimes     ~1.0 GB  (if the chat runtime does not start, move them to CPU: -ngl 0)
#   CUDA buffers                    ~0.5 GB
# --parallel 1      one request at a time: the whole window for that request (lab: quality over load).
# -c 12288          12k tokens per request (vs 8k today): more passages and history fit.
# -fa on            flash attention, required to quantize the V cache (older llama.cpp builds: plain -fa).
# -ctk/-ctv q8_0    KV cache in 8 bits: half the memory of f16, no measurable quality loss.
# --jinja           Qwen3 chat template.
# --reasoning-budget 0  no "thinking" output: the RAG prompts expect a direct answer / JSON. Thinking can be
#                   tried later for multi-step questions only (much slower on this GPU).
LLAMA_ARGS=-ngl 99 --no-mmap --parallel 1 -c 12288 -fa on -ctk q8_0 -ctv q8_0 --jinja --reasoning-budget 0 --timeout 300
MEMORY_HIGH=1536M
MEMORY_MAX=2G

# RAG service overrides that must go with this runtime (env of the RAG API on msp):
#   RAG_LLM_MAX_CONCURRENT=1          = --parallel 1
#   RAG_CHAT_MAX_INFLIGHT=3           turns admitted at once (default 6): with one slot, more admitted turns
#                                     only wait in the runtime queue and then fail with 503 after ~20 s;
#                                     refused at the door instead, with Retry-After
#   RAG_QUERY_ANALYSIS_TIMEOUT=30     a 14B model on this GPU is ~2x slower; with the 6 s default the analyzer
#                                     would time out and fall back to concatenating the previous question
#   RAG_LLM_TIMEOUT_SECONDS=240
