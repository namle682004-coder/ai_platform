# Env file for docker-compose.server.yml on the internal server (msp / 172.16.20.2).
# Copy to ~/aip/aip.env on the server (outside the code directory, so redeploys keep it),
# fill in the secrets, and `chmod 600` it. Never commit the filled-in copy.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Shared secret between gateway, RAG API/worker and the embedding server (:8012).
# Generate once: openssl rand -hex 32
AIP_RUNTIME_TOKEN=
MASTER_PEPPER=
JWT_SECRET=

# /admin/* (key issuance, admin UI) is protected only by this allowlist. Keep it to the
# server itself (the Docker network gateway seen by `curl localhost:8000`) and admin PCs —
# never the whole LAN range, or anyone can mint keys for any tenant.
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,<docker-network-gateway>/32,<admin-pc-ip>/32

# MongoDB (Atlas). Holds API keys, model aliases, RAG documents/sessions.
MONGO_URI=

# Infra containers of the aip-infra compose project (same Docker network)
REDIS_URL=redis://:<redis-password>@aip-redis:6379/0
RABBITMQ_URL=amqp://aip:<rabbitmq-password>@aip-rabbitmq:5672/aip
MINIO_ENDPOINT=http://aip-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
QDRANT_URL=http://aip-qdrant:6333

# Model runtimes on the host (also registered as aliases in MongoDB)
VLLM_SERVER_URL=http://172.16.20.2:8011/v1

# AIP Centralized Model Gateway (LiteLLM on Port 4000)
# Tự động chuyển đổi / fallback giữa Local Qwen 7B và Cloud API (Gemini Free, Claude, OpenAI)
GEMINI_API_KEY=
AIP_MASTER_KEY=sk-aip-master-key-lenam2026
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Điều hướng RAG API qua LiteLLM Gateway (tận dụng auto-switching & Gemini Free fallback)
RAG_LLM_URL=http://aip-litellm:4000/v1

# Google sign-in for the web UI (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data source connectors (solutions/rag/CONNECTORS.md). A source names the variable holding its secret;
# only names starting with AIP_SOURCE_SECRET_ are read. rag-api (Thử kết nối) and rag-worker (sync) both use it.
# AIP_SOURCE_SECRET_INTRANET=
