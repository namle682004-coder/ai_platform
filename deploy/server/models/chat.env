# Chat LLM runtime (Qwen2.5-7B-Instruct Q4_K_M) – /etc/aip/models/chat.env
LLAMA_SERVER=/home/lenam/llama.cpp/build/bin/llama-server
MODEL_PATH=/home/lenam/models/Qwen2.5-7B-Instruct/Qwen2.5-7B-Instruct-Q4_K_M.gguf
HOST=0.0.0.0
PORT=8011
# -ngl 99      every layer on the GPU (TITAN Xp 12 GB): the weights live in VRAM, not in host RAM.
# --no-mmap    do not keep a memory-mapped copy of the 4.4 GB weight file in host RAM. With mmap the
#              process held ~81% of the 8 GB host RAM on 2026-11-05.
# --parallel 2 two requests at a time (= RAG_LLM_MAX_CONCURRENT); more requests queue inside the server
#              instead of each taking memory.
# -c 16384     context shared by the slots: 8192 tokens per request. The KV cache is in VRAM (~1 GB).
#              The RAG service reads the per-request window from /props and fits its prompts to it.
LLAMA_ARGS=-ngl 99 --no-mmap --parallel 2 -c 16384 --timeout 120
MEMORY_HIGH=1536M
MEMORY_MAX=2G
